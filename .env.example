# Copia este fichero a .env (en la raiz del proyecto) y rellena los valores.

# Obligatoria: API key de OpenAI para el LLM del sistema multiagente.
OPENAI_API_KEY=

# Obligatoria: el modelo de OpenAI que quieres que use el sistema multiagente. No hay valor
# por defecto a proposito: pon el identificador exacto del modelo que tengas disponible con
# tu API key (por ejemplo, el que uses habitualmente para tool-calling).
OPENAI_MODEL=

# Opcional: puerto local del servidor MCP (src/agente/servidor_mcp/mcp_server.py). Por defecto 8765.
MCP_SERVER_PORT=8765

# Opcional: trazas del sistema multiagente en LangSmith (smith.langchain.com), para auditar
# que agente actuo en cada turno, que tool llamo cada uno, con que argumentos y que devolvio,
# y los handoffs (Command) entre supervisor y especialistas. Sin API key propia, deja
# LANGSMITH_TRACING en blanco o en "false": el agente funciona igual, solo sin trazas.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartdeliveryai-reparto
